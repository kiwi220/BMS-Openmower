<?xml version="1.0"?>
<package format="2">
  <name>bms_ble</name>
  <version>0.2.0</version>
  <description>
    Reads one or more BLE battery management systems (JK-BMS, JBD-BMS, ANT-BMS) via the
    aiobmsble library and publishes sensor_msgs/BatteryState, optionally
    mower_msgs/Bms for OpenMower.
  </description>
  <maintainer email="info@ki-wi.de">kiwi220</maintainer>
  <license>GPL-3.0-only</license>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>python3-catkin-pkg</build_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>rospkg</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <!-- aiobmsble/bleak need Python >= 3.12 and have no rosdep keys:
       bridge/setup_venv.sh creates a separate environment for them. -->
  <!-- mower_msgs (open_mower_ros) is optional and imported at runtime only
       when ~openmower_status_topic is set. -->
  <!-- xbot_msgs (open_mower_ros) is optional as well: imported at runtime only
       for ~publish_xbot_sensors; without it the node logs a warning and continues. -->

  <test_depend>python3-nose</test_depend>
</package>
