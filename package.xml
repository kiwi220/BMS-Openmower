<?xml version="1.0"?>
<package format="2">
  <name>jk_bms_ble</name>
  <version>0.1.0</version>
  <description>
    Reads a JK-BMS (Jikong, e.g. JK-BD4A8S4P) via Bluetooth LE and publishes
    sensor_msgs/BatteryState, optionally mower_msgs/Bms for OpenMower.
  </description>
  <maintainer email="info@ki-wi.de">kiwi220</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>python3-catkin-pkg</build_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <!-- bleak has no rosdep key: pip3 install -r requirements.txt -->
  <!-- mower_msgs (open_mower_ros) is optional and imported at runtime only
       when ~openmower_status_topic is set. -->

  <test_depend>python3-nose</test_depend>
</package>
